{
  "model": "LiquidAI/LFM3-1.7B-Base",
  "mode": "recent_only",
  "train": "runs/trace_data/train_4k.jsonl",
  "val": "runs/trace_data/val_4k.jsonl",
  "out": "runs/memory_lora/recent_only_pilot",
  "seed": 42,
  "max_steps": 10,
  "batch_size": 2,
  "grad_accum": 4,
  "memory_tokens": 2048,
  "recent_tokens": 384,
  "target_tokens": 192,
  "min_memory_tokens": 64,
  "slots": 16,
  "latent_size": 256,
  "heads": 4,
  "source_layer": 7,
  "inject_layer": 16,
  "encoder_mode": "backbone",
  "gate_init": 0.05,
  "sigreg_weight": 0.0,
  "lr": 0.0001,
  "weight_decay": 0.01,
  "lora_rank": 16,
  "lora_alpha": 32,
  "eval_every": 5,
  "eval_tasks": 16,
  "checkpoint_every": 5,
  "max_grad_norm": 1.0,
  "minimum_free_gib": 80
}
