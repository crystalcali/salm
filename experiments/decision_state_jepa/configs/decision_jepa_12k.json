{
  "model": "LiquidAI/LFM3-1.7B-Base",
  "mode": "decision_jepa",
  "train": "runs/decision_state_data/train.jsonl",
  "val": "runs/decision_state_data/val.jsonl",
  "out": "runs/decision_state/decision_jepa_12k",
  "seed": 42,
  "max_seq_length": 12288,
  "target_tokens": 768,
  "batch_size": 1,
  "grad_accum": 8,
  "max_steps": 2000,
  "lr": 0.0001,
  "lora_rank": 16,
  "lora_alpha": 32,
  "source_layer": 12,
  "inject_layer": 18,
  "latent_size": 256,
  "predictor_width": 512,
  "gate_init": 0.05,
  "jepa_weight": 0.2,
  "eval_every": 200,
  "eval_tasks": 100,
  "save_every": 200,
  "min_free_gib": 95
}
