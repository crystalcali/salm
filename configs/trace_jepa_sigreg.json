{
  "mode": "jepa_sigreg",
  "train": "runs/trace_data/train.jsonl",
  "val": "runs/trace_data/val.jsonl",
  "out": "runs/trace_jepa",
  "model": "LiquidAI/LFM3-1.7B-Base",
  "seed": 42,
  "max_steps": 20,
  "batch_size": 4,
  "grad_accum": 2,
  "max_length": 384,
  "layers": [
    7,
    12
  ],
  "latent_size": 256,
  "predictor_width": 512,
  "projections": 128,
  "sigreg_weight": 0.02,
  "jepa_weight": 0.2,
  "lora_rank": 16,
  "lora_alpha": 32,
  "lr": 0.0001,
  "weight_decay": 0.01,
  "checkpoint_every": 10,
  "eval_every": 10,
  "eval_limit": 30,
  "gradient_checkpointing": false,
  "use_lora": true
}
